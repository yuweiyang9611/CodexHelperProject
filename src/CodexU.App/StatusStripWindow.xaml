<Window x:Class="CodexU.App.StatusStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="46"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="codexU 使用状态"
        AutomationProperties.Name="codexU 使用状态条"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        KeyDown="Window_KeyDown">
    <Border x:Name="Shell" CornerRadius="13" BorderBrush="#35FFFFFF" BorderThickness="1"
            Background="#F2161B2A" Padding="8">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="LockPositionMenuItem"
                          Header="锁定位置"
                          IsCheckable="True"
                          Click="LockPosition_Click"
                          AutomationProperties.Name="锁定状态条位置"
                          AutomationProperties.HelpText="锁定后忽略鼠标拖动；再次选择可解锁" />
                <Separator />
                <MenuItem x:Name="ResetPositionMenuItem"
                          Header="重置位置 / 重新跟随 Codex"
                          Click="ResetPosition_Click"
                          AutomationProperties.Name="重置状态条位置并重新跟随 Codex"
                          AutomationProperties.HelpText="清除手动位置，并让状态条重新跟随 Codex 窗口" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragSurface" Grid.Row="0" Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TodayColumn" Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Button Content="C" Click="Open_Click" Width="27" Height="27" Padding="0" FontSize="12"
                        Foreground="White" FontWeight="Bold" BorderThickness="0" Background="#715FE9" Cursor="Hand"
                        AutomationProperties.Name="打开 codexU 完整看板" />
                <Border x:Name="DragHandle" Grid.Column="1" Width="18" Height="24" Background="Transparent"
                        ToolTip="按住拖动状态条；右键可重新跟随 Codex"
                        AutomationProperties.Name="拖动状态条"
                        AutomationProperties.HelpText="按住鼠标左键拖动；右键可重置位置">
                    <TextBlock x:Name="DragGlyph" Text="⠿" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI Symbol" FontSize="13" Foreground="#68738B"
                               AutomationProperties.Name="拖动状态条"
                               AutomationProperties.HelpText="按住鼠标左键拖动状态条"
                               IsHitTestVisible="False" />
                </Border>
                <TextBlock x:Name="PrimaryBlock" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="#8E9AB4" FontSize="11" TextTrimming="CharacterEllipsis">
                    <Run x:Name="PrimaryLabel" Text="5h 剩余  " />
                    <Run x:Name="PrimaryText" Foreground="White" FontWeight="SemiBold" Text="--" />
                </TextBlock>
                <TextBlock x:Name="SecondaryBlock" Grid.Column="3" VerticalAlignment="Center"
                           Foreground="#8E9AB4" FontSize="11" TextTrimming="CharacterEllipsis">
                    <Run x:Name="SecondaryLabel" Text="7d 剩余  " />
                    <Run x:Name="SecondaryText" Foreground="White" FontWeight="SemiBold" Text="--" />
                </TextBlock>
                <TextBlock x:Name="TodayBlock" Grid.Column="4" VerticalAlignment="Center"
                           Foreground="#8E9AB4" FontSize="11" Text="今日  "
                           TextTrimming="CharacterEllipsis">
                    <Run x:Name="TodayText" Foreground="White" FontWeight="SemiBold" Text="--" />
                </TextBlock>
                <ToggleButton x:Name="ExpandToggle" Grid.Column="5" Width="26" Height="26" Padding="0"
                              BorderThickness="0" Background="Transparent" Foreground="#77839C" Cursor="Hand"
                              Click="ExpandToggle_Click"
                              PreviewKeyDown="ExpandToggle_PreviewKeyDown"
                              AutomationProperties.Name="展开状态条详细信息"
                              AutomationProperties.HelpText="按 Enter 或空格固定展开，按 Escape 收起">
                    <TextBlock x:Name="StateGlyph" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{Binding Foreground, ElementName=ExpandToggle}"
                               FontSize="12" Text="…" IsHitTestVisible="False" />
                </ToggleButton>
            </Grid>

            <ScrollViewer x:Name="Details" Grid.Row="1" Visibility="Collapsed" Margin="2,14,2,2"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          AutomationProperties.Name="状态条详细信息">
                <StackPanel>
                    <TextBlock x:Name="RuntimeTitle" Text="Codex 使用状态" Foreground="White"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdatedText" Margin="0,2,0,11" Foreground="#707C96"
                               FontSize="11" Text="尚未读取本机数据" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PrimaryDetailLabel" Text="5 小时剩余额度"
                               Foreground="#9FA9BE" FontSize="12" />
                    <Grid Height="16" Margin="0,3,0,7">
                        <ProgressBar x:Name="PrimaryProgress" Height="6" VerticalAlignment="Center" Maximum="100"
                                     AutomationProperties.Name="5 小时剩余额度不可用" />
                        <TextBlock x:Name="PrimaryProgressStatus" Text="不可用" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Foreground="#F0B35A" FontSize="10"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock x:Name="SecondaryDetailLabel" Text="7 天剩余额度"
                               Foreground="#9FA9BE" FontSize="12" />
                    <Grid Height="16" Margin="0,3,0,10">
                        <ProgressBar x:Name="SecondaryProgress" Height="6" VerticalAlignment="Center" Maximum="100"
                                     AutomationProperties.Name="7 天剩余额度不可用" />
                        <TextBlock x:Name="SecondaryProgressStatus" Text="不可用" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Foreground="#F0B35A" FontSize="10"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="WeekBlock">
                            <TextBlock Text="近 7 天" Foreground="#707C96" FontSize="11" />
                            <TextBlock x:Name="WeekText" Text="--" Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="LifetimeBlock" Grid.Column="1">
                            <TextBlock Text="累计" Foreground="#707C96" FontSize="11" />
                            <TextBlock x:Name="LifetimeText" Text="--" Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="TodoBlock" Grid.Column="2">
                            <TextBlock Text="未完成待办" Foreground="#707C96" FontSize="11" />
                            <TextBlock x:Name="TodoText" Text="--" Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RefreshButton" Content="立即刷新" Click="Refresh_Click" Height="30"
                                Foreground="White" BorderThickness="0" Background="#353D59"
                                AutomationProperties.Name="立即刷新顶部状态条" />
                        <Button Grid.Column="2" Content="打开完整看板" Click="Open_Click" Height="30"
                                Foreground="White" BorderThickness="0" Background="#6457D8"
                                AutomationProperties.Name="打开 codexU 完整看板" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
