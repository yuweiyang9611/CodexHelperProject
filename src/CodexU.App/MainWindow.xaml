<Window x:Class="CodexU.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="codexU"
        Width="1080"
        Height="810"
        MinWidth="640"
        MinHeight="480"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#D90D1220">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#70A7FF" Offset="0" />
                                <GradientStop Color="#7157E8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="U" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                    </Border>
                    <TextBlock Text="codexU" Foreground="{StaticResource TitleBarForegroundBrush}"
                               FontWeight="SemiBold" FontSize="14" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="WINDOWS" Foreground="#77829B" FontSize="11" FontWeight="Bold"
                               Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" Click="Minimize_Click"
                            AutomationProperties.Name="最小化窗口" />
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="□" Click="Maximize_Click"
                            AutomationProperties.Name="最大化或还原窗口" />
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarButtonStyle}" Content="✕" Click="Close_Click"
                            ToolTip="隐藏到系统托盘"
                            AutomationProperties.Name="隐藏窗口到系统托盘" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="Transparent"
                              AutomationProperties.Name="codexU 本地用量仪表盘" />
                <Border x:Name="LoadingOverlay" Background="#101523">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="18" Margin="0,0,0,18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#70A7FF" Offset="0" />
                                    <GradientStop Color="#7157E8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="U" Foreground="White" FontWeight="Bold" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="StatusText" Text="正在启动本地用量看板…"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="#B6BED0" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
